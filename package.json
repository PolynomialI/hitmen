{
  "name": "the-hooded-hand",
  "private": true,
  "version": "0.1.0",
  "description": "The Hooded Hand - a medieval tavern card game of nerve and treachery. Browser-based, multiplayer-ready.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/index.js --packages=external",
    "start": "node dist-server/index.js",
    "server:dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/sim.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@fontsource/alegreya": "5.2.5",
    "@fontsource/grenze-gotisch": "5.2.5",
    "@fontsource/im-fell-english-sc": "5.2.5",
    "@types/node": "22.15.21",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.10",
    "postprocessing": "6.37.8",
    "three": "0.180.0",
    "troika-three-text": "0.52.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
